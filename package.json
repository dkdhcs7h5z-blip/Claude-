{
  "name": "womens-health-intelligence-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Women's Health, Obstetrics, Gynecology, Reproductive Medicine & Fetal Medicine Intelligence Platform",
  "scripts": {
    "dev": "vite",
    "build:preview": "VITE_EMBED=1 VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= vite build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:db": "bash supabase/tests/run_db_tests.sh",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "build:demo": "VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= vite build && tsc -b --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "i18next": "^27.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
